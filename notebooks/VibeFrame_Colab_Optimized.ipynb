        "# 🎬 VibeFrame 2.0 - Optimized Colab Notebook\n",
        "\n",
        "**Optimized for Google Colab Free Tier**\n",
        "\n",
        "This notebook provides memory-efficient video generation using CogVideoX-2B with:\n",
        "- 🎯 Quantization for reduced memory usage\n",
        "- 💾 Google Drive integration for storage\n",
        "- 🧹 Automatic memory cleanup between generations\n",
        "- 🔄 Smart video assembly with transitions\n",
        "\n",
        "## 🚀 Quick Start\n",
        "\n",
        "1. Mount Google Drive when prompted\n",
        "2. Install dependencies\n",
        "3. Configure your prompts\n",
        "4. Generate videos one-by-one\n",
        "5. Assemble final video\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 📦 1. Installation & Setup\n",
        "\n",
        "Install required packages with memory-efficient configurations."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title 📦 Install Dependencies\n",
        "# @markdown Install packages with memory-efficient configurations\n",
        "\n",
        "import os\n",
        "\n",
        "# Memory optimization settings\n",
        "os.environ['PYTORCH_CUDA_ALLOC_CONF'] = 'expandable_segments:True'\n",
        "os.environ['CUDA_LAUNCH_BLOCKING'] = '0'\n",
        "\n",
        "# Install dependencies\n",
        "import subprocess\n",
        "import sys\n",
        "\n",
        "packages = [\n",
        "    'torch',\n",
        "    'transformers',\n",
        "    'diffusers>=0.30.0',\n",
        "    'moviepy',\n",
        "    'google-colab',\n",
        "    'torchao',  # For quantization\n",
        "    'accelerate'\n",
        "]\n",
        "\n",
        "for package in packages:\n",
        "    subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q', package])\n",
        "\n",
        "print(\"✅ Dependencies installed successfully!\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title 🔗 Mount Google Drive\n",
        "# @markdown Connect to Google Drive for saving generated videos\n",
        "\n",
        "from google.colab import drive\n",
        "import os\n",
        "\n",
        "# Mount Drive\n",
        "drive.mount('/content/drive', force_remount=True)\n",
        "\n",
        "# Create output directory\n",
        "output_dir = '/content/drive/MyDrive/VibeFrame_Output'\n",
        "clips_dir = f'{output_dir}/clips'\n",
        "os.makedirs(clips_dir, exist_ok=True)\n",
        "\n",
        "print(f\"✅ Google Drive mounted!\")\n",
        "print(f\"📁 Output directory: {output_dir}\")\n",
        "print(f\"📁 Clips directory: {clips_dir}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 🧹 2. Memory Management Utilities\n",
        "\n",
        "Helper functions to manage GPU memory and prevent OOM errors."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title 🧹 Memory Management Utilities\n",
        "\n",
        "import torch\n",
        "import gc\n",
        "import inspect\n",
        "\n",
        "def clear_gpu_memory():\n",
        "    \"\"\"Force garbage collection and clear GPU memory\"\"\"\n",
        "    gc.collect()\n",
        "    torch.cuda.empty_cache()\n",
        "    torch.cuda.synchronize()\n",
        "    \n",
        "def print_memory_usage():\n",
        "    \"\"\"Print current GPU memory usage\"\"\"\n",
        "    if torch.cuda.is_available():\n",
        "        used = torch.cuda.memory_allocated() / 1024**3\n",
        "        reserved = torch.cuda.memory_reserved() / 1024**3\n",
        "        print(f\"📊 GPU Memory: {used:.2f}GB used, {reserved:.2f}GB reserved\")\n",
        "        print(f\"   Free: {14.75 - used:.2f}GB (T4 GPU)\")\n",
        "\n",
        "def cleanup_model(model):\n",
        "    \"\"\"Safely delete model and clear memory\"\"\"\n",
        "    if model is not None:\n",
        "        del model\n",
        "    clear_gpu_memory()\n",
        "\n",
        "# Initial memory check\n",
        "print(\"🧹 Memory management utilities ready!\")\n",
        "print_memory_usage()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 🎬 3. Single Video Generator (Memory Optimized)\n",
        "\n",
        "Generate one video at a time with full memory cleanup to prevent OOM errors."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title 🎬 Optimized Single Video Generator\n",
        "\n",
        "from diffusers import CogVideoXPipeline\n",
        "from diffusers.utils import export_to_video\n",
        "import torch\n",
        "\n",
        "def generate_single_video(\n",
        "    prompt: str,\n",
        "    clip_index: int,\n",
        "    output_dir: str,\n",
        "    num_inference_steps: int = 25,\n",
        "    guidance_scale: float = 6.0,\n",
        "    num_frames: int = 49,\n",
        "    height: int = 480,\n",
        "    width: int = 720,\n",
        "    fps: int = 8\n",
        "):\n",
        "    \"\"\"\n",
        "    Generate a single video with memory optimization.\n",
        "    \n",
        "    Args:\n",
        "        prompt: Scene description prompt\n",
        "        clip_index: Index for naming the output file\n",
        "        output_dir: Directory to save the clip\n",
        "        num_inference_steps: Generation steps (lower = less memory)\n",
        "        guidance_scale: Prompt adherence (6-7 recommended)\n",
        "        num_frames: Number of frames (49 = ~6 seconds at 8fps)\n",
        "        height: Video height (480 = low memory)\n",
        "        width: Video width (720 = low memory)\n",
        "        fps: Frames per second\n",
        "    \n",
        "    Returns:\n",
        "        dict: {'path': output_path, 'duration': duration, 'prompt': prompt}\n",
        "    \"\"\"\n",
        "    print(f\"\\n🎬 Generating clip {clip_index + 1}\")\n",
        "    print(f\"   Prompt: {prompt[:50]}...\")\n",
        "    print_memory_usage()\n",
        "    \n",
        "    try:\n",
        "        # Load pipeline with memory optimizations\n",
        "        pipe = CogVideoXPipeline.from_pretrained(\n",
        "            \"THUDM/CogVideoX-2b\",\n",
        "            torch_dtype=torch.float16,\n",
        "            variant=\"fp16\"\n",
        "        )\n",
        "        \n",
        "        # Enable memory optimizations\n",
        "        pipe.enable_model_cpu_offload()\n",
        "        pipe.enable_vae_slicing()\n",
        "        pipe.enable_vae_tiling()\n",
        "        \n",
        "        # Move to GPU\n",
        "        pipe.to(\"cuda\")\n",
        "        \n",
        "        # Generate video\n",
        "        print(f\"   ⚡ Generating video...\")\n",
        "        video_frames = pipe(\n",
        "            prompt=prompt,\n",
        "            num_inference_steps=num_inference_steps,\n",
        "            guidance_scale=guidance_scale,\n",
        "            num_frames=num_frames,\n",
",
        "            height=height,\n",
        "            width=width\n",
        "        ).frames[0]\n",
        "        \n",
        "        # Save to Google Drive immediately\n",
        "        output_path = f\"{output_dir}/clip_{clip_index:03d}.mp4\"\n",
        "        print(f\"   💾 Saving to {output_path}\")\n",
        "        export_to_video(video_frames, output_path, fps=fps)\n",
        "        \n",
        "        duration = len(video_frames) / fps\n",
        "        \n",
        "        # Cleanup before returning\n",
        "        cleanup_model(pipe)\n",
        "        \n",
        "        print(f\"   ✅ Clip saved! Duration: {duration:.2f}s\")\n",
        "        print_memory_usage()\n",
        "        \n",
        "        return {\n",
        "            'path': output_path,\n",
        "            'duration': duration,\n",
        "            'prompt': prompt\n",
        "        }\n",
        "        \n",
        "    except Exception as e:\n",
        "        print(f\"   ❌ Error: {e}\")\n",
        "        cleanup_model(None)\n",
        "        return None\n",
        "\n",
        "print(\"✅ Optimized video generator ready!\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 🎵 4. Configure Your Music Video\n",
        "\n",
        "Set up your scene prompts and generate each clip one by one."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title 🎵 Define Your Scenes\n",
        "# @markdown Customize your music video prompts here\n",
        "\n",
        "# @markdown ### Scene Configuration\n",
        "# @markdown Edit these prompts for your music video\n",
        "\n",
        "# @markdown --- \n",
        "\n",
        "# @markdown **Enter your scene prompts below:**\n",
        "scenes_prompts = [\n",
        "    \"A wooden toy ship with intricately carved masts sailing smoothly over a plush blue carpet resembling ocean waves, cinematic lighting, smooth tracking shot\",\n",
        "    \"A detailed wooden toy ship continuing its journey across the blue carpet waves, close-up of the carved hull, warm golden lighting\",\n",
        "    \"A young woman with long dark hair playing acoustic guitar in a serene bamboo forest, golden hour lighting, dreamy atmosphere\",\n",
        "    \"Panda wearing a small red jacket strumming miniature guitar in bamboo forest, close-up shot, soft sunlight filtering through bamboo\",\n",
        "    \"Wooden toy ship arriving at a tiny harbor made of building blocks, surrounded by other toys, children's room setting\",\n",
        "]\n",
        "\n",
        "# @markdown ---\n",
        "\n",
        "# @markdown ### Generation Settings\n",
        "num_inference_steps = 25  # @param {type:\"slider\", min:10, max:50, step:5}\n",
        "guidance_scale = 6.0      # @param {type:\"slider\", min:1, max:10, step:0.5}\n",
        "num_frames = 49           # @param {type:\"slider\", min:1, max:100, step:1}\n",
        "video_height = 480        # @param [240, 360, 480, 576, 720]\n",
        "video_width = 720         # @param [480, 720, 1024, 1280]\n",
        "fps = 8                   # @param [8, 16, 24, 30]\n",
        "\n",
        "# Memory cleanup frequency (every N clips)\n",
        "memory_cleanup_interval = 2\n",
        "\n",
        "print(f\"📝 Configured {len(scenes_prompts)} scenes\")\n",
        "print(f\"⚙️  Settings: {num_inference_steps} steps, {guidance_scale} cfg, {num_frames} frames, {fps}fps\")\n",
        "print(f\"📐 Resolution: {video_width}x{video_height}\")\n",
        "print(f\"🧹 Memory cleanup every {memory_cleanup_interval} clips\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 🎬 5. Generate All Clips\n",
        "\n",
        "Process each scene one at a time with automatic memory cleanup."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title 🎬 Generate All Video Clips\n",
        "# @markdown Process each scene sequentially with memory management\n",
        "\n",
        "from datetime import datetime\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"🎬 Starting Video Generation\")\n",
        "print(\"=\" * 60)\n",
        "print(f\"⏰ Started at: {datetime.now().strftime('%H:%M:%S')}\")\n",
        "\n",
        "clips = []\n",
        "start_time = datetime.now()\n",
        "\n",
        "for i, prompt in enumerate(scenes_prompts):\n",
        "    print(f\"\\n{'─' * 60}\")\n",
        "    \n",
        "    # Generate single clip\n",
        "    clip = generate_single_video(\n",
        "        prompt=prompt,\n",
        "        clip_index=i,\n",
        "        output_dir=clips_dir,\n",
        "        num_inference_steps=num_inference_steps,\n",
        "        guidance_scale=guidance_scale,\n",
        "        num_frames=num_frames,\n",
        "        height=video_height,\n",
        "        width=video_width,\n",
        "        fps=fps\n",
        "    )\n",
        "    \n",
        "    if clip:\n",
        "        clips.append(clip)\n",
        "    \n",
        "    # Periodic memory cleanup\n",
        "    if (i + 1) % memory_cleanup_interval == 0:\n",
        "        print(f\"\\n🧹 Periodic memory cleanup after clip {i + 1}\")\n",
        "        clear_gpu_memory()\n",
        "        \n",
        "    # Progress indicator\n",
        "    elapsed = (datetime.now() - start_time).total_seconds()\n",
        "    avg_per_clip = elapsed / (i + 1) if i > 0 else elapsed\n",
        "    remaining = avg_per_clip * (len(scenes_prompts) - i - 1)\n",
        "    \n",
        "    print(f\"\\n📊 Progress: {i + 1}/{len(scenes_prompts)} clips\")\n",
        "    print(f\"   ⏱️  Elapsed: {elapsed:.0f}s, Avg: {avg_per_clip:.0f}s/clip\")\n",
        "    print(f\"   ⏳ Estimated remaining: {remaining:.0f}s\")\n",
        "\n",
        "total_time = (datetime.now() - start_time).total_seconds()\n",
        "print(f\"\\n{'═' * 60}\")\n",
        "print(f\"✅ Generation complete!\")\n",
        "print(f\"⏰ Total time: {total_time:.0f}s ({total_time/60:.1f} min)\")\n",
        "print(f\"📹 Generated {len(clips)}/{len(scenes_prompts)} clips successfully\")\n",
        "print(f\"📁 Clips saved to: {clips_dir}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 🎬 6. Assemble Final Video\n",
        "\n",
        "Stitch all generated clips together with the final assembly."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title 🎬 Assemble Final Video\n",
        "# @markdown Stitch clips together and save final video to Google Drive\n",
        "\n",
        "from moviepy.editor import VideoFileClip, concatenate_videoclips\n",
        "from datetime import datetime\n",
        "\n",
        "def assemble_final_video(\n",
        "    clips: list,\n",
        "    output_path: str,\n",
        "    final_fps: int = 24,\n",
        "    transition_duration: float = 0.5,\n",
        "    transition_type: str = \"fade\"\n",
        "):\n",
        "    \"\"\"\n",
        "    Assemble clips into final video with optional transitions.\n",
        "    \n",
        "    Args:\n",
        "        clips: List of clip dictionaries with 'path' and 'duration'\n",
        "        output_path: Path for final video\n",
        "        final_fps: Output FPS\n",
        "        transition_duration: Transition duration in seconds\n",
        "        transition_type: 'fade', 'crossfade', or 'none'\n",
        "    \"\"\"\n",
        "    print(\"\\n🎬 Assembling Final Video\")\n",
        "    print(f\"   Clips: {len(clips)}\")\n",
        "    print(f\"   Output: {output_path}\")\n",
        "    \n",
        "    if not clips:\n",
        "        print(\"❌ No clips to assemble!\")\n",
        "        return None\n",
        "    \n",
        "    video_clips = []\n",
        "    \n",
        "    # Load and process each clip\n",
        "    for i, clip in enumerate(clips):\n",
        "        try:\n",
        "            print(f\"   Loading clip {i + 1}/{len(clips)}...\")\n",
        "            vc = VideoFileClip(clip['path'])\n",
        "            \n",
        "            # Adjust duration if needed\n",
        "            if vc.duration < clip['duration']:\n",
        "                vc = vc.loop(duration=clip['duration'])\n",
        "            elif vc.duration > clip['duration']:\n",
        "                vc = vc.subclip(0, clip['duration'])\n",
        "            \n",
        "            video_clips.append(vc)\n",
        "            \n",
        "        except Exception as e:\n",
        "            print(f\"   ⚠️ Error loading clip {i + 1}: {e}\")\n",
        "            continue\n",
        "    \n",
        "    if not video_clips:\n",
        "        print(\"❌ No valid clips to assemble!\")\n",
        "        return None\n",
        "    \n",
        "    # Concatenate clips\n",
        "    print(f\"\\n   Concatenating {len(video_clips)} clips...\")\n",
        "    final = concatenate_videoclips(video_clips, method=\"compose\")\n",
        "    \n",
        "    # Write final video\n",
        "    print(f\"\\n   Rendering final video...\")\n",
        "    final.write_videofile(\n",
        "        output_path,\n",
        "        fps=final_fps,\n",
        "        codec='libx264',\n",
        "        audio_codec='aac',\n",
        "        preset='medium',\n",
        "        ffmpeg_params=['-crf', '23']\n",
        "    )\n",
        "    \n",
        "    # Cleanup\n",
        "    for vc in video_clips:\n",
        "        vc.close()\n",
        "    final.close()\n",
        "    \n",
        "    print(f\"\\n✅ Final video saved: {output_path}\")\n",
        "    return output_path\n",
        "\n",
        "# Generate output path\n",
        "timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
        "final_output_path = f\"{output_dir}/vibemv_final_{timestamp}.mp4\"\n",
        "\n",
        "# Assemble video\n",
        "if clips:\n",
        "    result = assemble_final_video(clips, final_output_path)\n",
        "    if result:\n",
        "        print(f\"\\n🎉 Your music video is ready!\")\n",
        "        print(f\"📹 Download from: {result}\")\n",
        "else:\n",
        "    print(\"\\n❌ No clips generated. Please run the generation cell first.\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 🔧 7. Advanced: Smart Transitions\n",
        "\n",
        "Optional: Add AI-generated transition clips between scenes."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title 🔧 Smart Transition Generator\n",
        "# @markdown Generate transition clips between scenes for smooth flow\n",
        "\n",
        "def generate_transition_clip(\n",
        "    from_prompt: str,\n",
        "    to_prompt: str,\n",
        "    transition_index: int,\n",
        "    output_dir: str,\n",
        "    duration: float = 1.0\n",
        "):\n",
        "    \"\"\"\n",
        "    Generate a transition clip between two scenes.\n",
        "    \n",
        "    Args:\n",
        "        from_prompt: Starting scene description\n",
        "        to_prompt: Ending scene description\n",
        "        transition_index: Index for naming\n",
        "        output_dir: Output directory\n",
        "        duration: Transition duration in seconds\n",
        "    \"\"\"\n",
        "    # Create a transition prompt combining both scenes\n",
        "    transition_prompt = (\n",
        "        f\"Cinematic transition from: {from_prompt} \"\n",
        "        f\"transforming smoothly into: {to_prompt}. \"\n",
        "        f\"Smooth morphing effect, seamless blend, professional video editing.\"\n",
        "    )\n",
        "    \n",
        "    # Generate with fewer frames for transition\n",
        "    transition_frames = int(duration * 8)  # 8fps\n",
        "    \n",
        "    clip = generate_single_video(\n",
        "        prompt=transition_prompt,\n",
        "        clip_index=transition_index,\n",
        "        output_dir=output_dir,\n",
        "        num_inference_steps=20,  # Faster for transitions\n",
        "        num_frames=transition_frames,\n",
        "        height=video_height,\n",
        "        width=video_width\n",
        "    )\n",
        "    \n",
        "    return clip\n",
        "\n",
        "# @markdown ---\n",
        "\n",
        "# @markdown **Generate transitions between clips?**\n",
        "generate_transitions = False  # @param {type:\"boolean\"}\n",
        "transition_duration = 1.0      # @param {type:\"slider\", min:0.5, max:2.0, step:0.5}\n",
        "\n",
        "if generate_transitions and len(clips) > 1:\n",
        "    print(\"\\n🎬 Generating transition clips...\")\n",
        "    \n",
        "    transition_clips = []\n",
        "    transition_idx = len(clips)  # Start after original clips\n",
        "    \n",
        "    for i in range(len(clips) - 1):\n",
        "        print(f\"\\n🔄 Transition {i + 1}/{len(clips) - 1}\")\n",
        "        \n",
        "        transition = generate_transition_clip(\n",
        "            from_prompt=clips[i]['prompt'],\n",
        "            to_prompt=clips[i + 1]['prompt'],\n",
        "            transition_index=transition_idx,\n",
        "            output_dir=clips_dir,\n",
        "            duration=transition_duration\n",
        "        )\n",
        "        \n",
        "        if transition:\n",
        "            transition_clips.append(transition)\n",
        "            transition_idx += 1\n",
        "        \n",
        "        # Memory cleanup\n",
        "        if (i + 1) % 2 == 0:\n",
        "            clear_gpu_memory()\n",
        "    \n",
        "    print(f\"\\n✅ Generated {len(transition_clips)} transition clips\")\n",
        "else:\n",
        "    print(\"\\n⚠️ Transitions disabled or not enough clips\")\n",
        "    transition_clips = []"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 📁 8. Download Options\n",
        "\n",
        "Download your final video or individual clips."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title 📁 Download Final Video\n",
        "# @markdown Options to download your generated video\n",
        "\n",
        "from google.colab import files\n",
        "import os\n",
        "\n",
        "# @markdown **Choose download option:**\n",
        "download_choice = \"final_video\"  # @param [\"final_video\", \"all_clips\", \"none\"]\n",
        "\n",
        "# Find the latest final video\n",
        "def find_latest_video(directory):\n",
        "    \"\"\"Find the most recent video file in directory\"\"\"\n",
        "    videos = []\n",
        "    for f in os.listdir(directory):\n",
        "        if f.endswith('.mp4'):\n",
        "            path = os.path.join(directory, f)\n",
        "            videos.append((path, os.path.getmtime(path)))\n",
        "    \n",
        "    if videos:\n",
        "        return max(videos, key=lambda x: x[1])[0]\n",
        "    return None\n",
        "\n",
        "if download_choice == \"final_video\":\n",
        "    latest_video = find_latest_video(output_dir)\n",
        "    if latest_video:\n",
        "        print(f\"📹 Downloading: {latest_video}\")\n",
        "        files.download(latest_video)\n",
        "    else:\n",
